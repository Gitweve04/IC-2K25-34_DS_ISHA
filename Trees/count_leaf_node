
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* left;
    Node* right;
};

int countNodes(Node* root) {
    if (root == NULL)
        return 0;

    return 1 + countNodes(root->left)
             + countNodes(root->right);
}

int countLeaf(Node* root) {
    if (root == NULL)
        return 0;

    if (root->left == NULL && root->right == NULL)
        return 1;

    return countLeaf(root->left)
         + countLeaf(root->right);
}

int main() {

    Node* root = new Node{10, NULL, NULL};

    root->left = new Node{20, NULL, NULL};
    root->right = new Node{30, NULL, NULL};

    root->left->left = new Node{40, NULL, NULL};
    root->left->right = new Node{50, NULL, NULL};

    cout << "Total Nodes: " << countNodes(root);
    cout << "\nLeaf Nodes: " << countLeaf(root);

    return 0;
}
