
#include <iostream>
#include <vector>
using namespace std;

vector<int> adj[20];
bool visited[20] = {false};

void DFS(int vertex) {

    visited[vertex] = true;

    cout << vertex << " ";

    for (int i = 0; i < adj[vertex].size(); i++) {

        int neighbour = adj[vertex][i];

        if (!visited[neighbour]) {
            DFS(neighbour);
        }
    }
}

int main() {

    int n, e, start;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    for (int i = 0; i < e; i++) {

        int u, v;
        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    cout << "DFS Traversal: ";

    DFS(start);

    return 0;
}
