
#include <iostream>
#include <vector>
using namespace std;

int main() {

    int n, e;

    cout << "Enter number of vertices: ";
    cin >> n;

    vector<int> adj[20];

    cout << "Enter number of edges: ";
    cin >> e;

    for (int i = 0; i < e; i++) {
        int u, v;

        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "\nAdjacency List:\n";

    for (int i = 0; i < n; i++) {

        cout << i << " -> ";

        for (int j = 0; j < adj[i].size(); j++) {
            cout << adj[i][j] << " ";
        }

        cout << endl;
    }

    return 0;
}
