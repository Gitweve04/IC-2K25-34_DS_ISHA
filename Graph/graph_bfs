
#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main() {

    int n, e;
    int start;

    cout << "Enter number of vertices: ";
    cin >> n;

    vector<int> adj[20];
    bool visited[20] = {false};

    cout << "Enter number of edges: ";
    cin >> e;

    for (int i = 0; i < e; i++) {

        int u, v;
        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    queue<int> q;

    visited[start] = true;
    q.push(start);

    cout << "BFS Traversal: ";

    while (!q.empty()) {

        int current = q.front();
        q.pop();

        cout << current << " ";

        for (int i = 0; i < adj[current].size(); i++) {

            int neighbour = adj[current][i];

            if (!visited[neighbour]) {

                visited[neighbour] = true;
                q.push(neighbour);
            }
        }
    }

    return 0;
}
