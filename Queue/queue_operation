#include<iostream>
#include<queue>
using namespace std;
int main(){
    queue<int> q;
    q.push(10);
    q.push(4);
    q.push(5);

    cout<<"Front element: "<< q.front() << endl;
    cout << "last element : " << q.back() << endl;

    q.pop();

    cout << "now, the front element : " << q.front()<<endl;

    return 0;
}
