
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

int main() {
    Node *head = NULL, *temp, *prev, *newNode;
    int n;

    cin >> n;

    for (int i = 0; i < n; i++) {
        newNode = new Node;
        cin >> newNode->data;
        newNode->next = NULL;

        if (head == NULL)
            head = newNode;
        else {
            temp = head;
            while (temp->next != NULL)
                temp = temp->next;
            temp->next = newNode;
        }
    }

    if (head == NULL) {
        cout << "List is empty";
    }
    else if (head->next == NULL) {
        delete head;
        head = NULL;
    }
    else {
        temp = head;

        while (temp->next != NULL) {
            prev = temp;
            temp = temp->next;
        }

        prev->next = NULL;
        delete temp;
    }

    temp = head;
    cout << "Updated List: ";

    while (temp != NULL) {
        cout << temp->data << " -> ";
        temp = temp->next;
    }

    cout << "NULL";
    return 0;
}
