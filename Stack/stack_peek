#include<iostream>
#include<stack>
using namespace std;

int main(){
    stack<int> s;
    s.push(10);
    s.push(20);
    s.push(30);
    
    //peek operation
    
     if (s.empty()) {
        cout << "Stack is Empty\n";
    }
    else {
        cout << "Top element is: " << s.top() << endl;
    }

    return 0;
}
